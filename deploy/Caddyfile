# Task 2.3 — reverse proxy + automatic HTTPS.
#
# HTTPS is not optional here: browsers refuse microphone access
# (getUserMedia) on any non-HTTPS origin except localhost. A phone on
# mobile data hitting a plain http:// address simply cannot grant mic
# permission, so the call can never start. Caddy gets and renews a real
# Let's Encrypt certificate automatically — just point a domain at this
# VM and set DOMAIN below.
#
# Serving frontend and backend from ONE origin is deliberate:
#   - the frontend's existing relative API paths (/auth, /bots, ...) keep
#     working unchanged, exactly as they do behind Vite's dev proxy
#   - CORS stops being a concern entirely (same origin)
#   - the refresh-token cookie stays same-site, no cross-origin cookie
#     rules to fight (Task 2.5)

{$DOMAIN} {
	encode gzip

	# API routes -> backend. Everything else falls through to the SPA.
	handle /auth/* {
		reverse_proxy backend:8080
	}
	handle /bots/* {
		reverse_proxy backend:8080
	}
	handle /connect* {
		reverse_proxy backend:8080
	}
	handle /documents/* {
		reverse_proxy backend:8080
	}
	# Public liveness check — Docker's HEALTHCHECK and any load balancer
	# need this without credentials, so its body is deliberately just
	# {"status": "ok"}. Anything worth reading lives behind /health/detail.
	handle /health {
		reverse_proxy backend:8080
	}

	# Task 4.7/4.9 — the operator's views. Both AUTHENTICATED at the
	# application layer (a logged-in user, or METRICS_TOKEN for a
	# Prometheus scraper), which is what makes them safe to route publicly
	# at all: between them they report which customer API hostnames have
	# tripped a circuit breaker and how many calls are live right now.
	handle /health/* {
		reverse_proxy backend:8080
	}
	handle /metrics {
		reverse_proxy backend:8080
	}

	# Found 2026-09-07, during Phase 3 live testing, BEFORE these features
	# were reached. Every route below existed in the backend and was
	# reachable in local development (Vite's dev proxy forwards anything it
	# does not serve), but was missing here — so in production each one fell
	# through to the SPA handler at the bottom and returned index.html with
	# HTTP 200. The frontend would then try to JSON.parse a page of HTML and
	# fail with a parse error rather than anything naming the real problem.
	#
	# The payment one is worse than a broken page: /payments is also where
	# the provider's own webhook lands (task 3.7). A provider POSTing a
	# "payment received" callback would have got 200 and HTML back, treated
	# it as delivered, and never retried — a paid order silently never
	# recorded.
	handle /approvals/* {
		reverse_proxy backend:8080
	}
	handle /webhooks/* {
		reverse_proxy backend:8080
	}
	handle /payments/* {
		reverse_proxy backend:8080
	}

	# Static frontend build (vite's dist/), with SPA fallback so client-side
	# routes like /dashboard survive a hard refresh.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
