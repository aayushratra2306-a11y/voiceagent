# Task 2.3 — server-side environment. Copy to deploy/.env ON THE SERVER
# and fill in. Never commit the real deploy/.env (it's gitignored).

# ── Deployment ────────────────────────────────────────────────────────────
# The domain pointing at this VM's public IP. Caddy gets a real Let's
# Encrypt certificate for it automatically. HTTPS is mandatory, not
# optional: browsers block microphone access on non-HTTPS origins, so a
# phone simply cannot start a call over plain http.
DOMAIN=voiceagent.example.com

# ── TURN relay (coturn) ───────────────────────────────────────────────────
# The VM's PUBLIC IP address, literally. coturn can't discover this itself
# on a cloud VM.
TURN_PUBLIC_IP=203.0.113.10
TURN_USER=voiceagent
# Generate a real one: openssl rand -base64 32
TURN_PASSWORD=change-me-to-something-random

# What the BACKEND hands to browsers as ICE config (app/core/config.py).
# Must match the coturn values above.
TURN_URL=turn:203.0.113.10:3478
TURN_USERNAME=voiceagent
TURN_CREDENTIAL=change-me-to-something-random

# ── Everything below mirrors backend/.env ─────────────────────────────────
MONGODB_URL=
DB_NAME=voiceagent
SECRET_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
PINECONE_API_KEY=
GROQ_API_KEY=

# Optional (Task 2.7) — leave blank to keep dormant.
SENTRY_DSN=
