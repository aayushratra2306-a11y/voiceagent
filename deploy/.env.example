# Task 2.3 — server-side environment. Copy to deploy/.env ON THE SERVER
# and fill in. Never commit the real deploy/.env (it's gitignored).

# ── Deployment ────────────────────────────────────────────────────────────
# The domain pointing at this VM's public IP. Caddy gets a real Let's
# Encrypt certificate for it automatically. HTTPS is mandatory, not
# optional: browsers block microphone access on non-HTTPS origins, so a
# phone simply cannot start a call over plain http.
DOMAIN=voiceagent.example.com

# ── TURN relay (coturn) ───────────────────────────────────────────────────
# The VM's PUBLIC IP address, literally. coturn can't discover this itself
# on a cloud VM.
TURN_PUBLIC_IP=203.0.113.10

# The VM's PRIVATE address — the one that actually appears on its network
# interface (`ip -4 addr show` / `hostname -I`). On GCP this is a 10.x
# address; on most clouds it is 10.x or 172.31.x.
#
# Required, not cosmetic. Without it coturn allocates relay sockets on
# every interface it can find, Docker's bridges included, then advertises
# them all under the public IP. Browsers get a relay candidate that looks
# right and silently goes nowhere.
TURN_LISTEN_IP=10.0.0.2
TURN_USER=voiceagent
# Generate a real one: openssl rand -hex 32
# Hex on purpose, not base64: this value is interpolated into coturn's
# `--user=USER:PASSWORD` command line in docker-compose.yml, and base64's
# `/ + =` characters invite shell-quoting bugs that surface as an
# authentication failure nobody can explain.
TURN_PASSWORD=change-me-to-something-random

# What the BACKEND hands to browsers as ICE config (app/core/config.py).
# Must match the coturn values above.
TURN_URL=turn:203.0.113.10:3478
TURN_USERNAME=voiceagent
TURN_CREDENTIAL=change-me-to-something-random

# ── Everything below mirrors backend/.env ─────────────────────────────────
MONGODB_URL=
DB_NAME=voiceagent
SECRET_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
PINECONE_API_KEY=
GROQ_API_KEY=

# Optional (Task 2.7) — leave blank to keep dormant.
SENTRY_DSN=

# Optional (Phase 4) — leave blank for a single API replica, which is what
# this deployment runs today; every one of the settings this backs (the
# call concurrency cap, the active-call registry, the rate limiter) keeps
# behaving exactly as before with this blank. Set it only once you are
# actually running more than one API replica behind a load balancer:
#   REDIS_URL=redis://redis:6379/0
# ("redis" is the service name docker-compose.yml adds — reachable from the
# backend container by that name on the compose network, nothing to expose
# to the host.)
REDIS_URL=

# Optional (Task 4.9) — the /metrics scrape endpoint. On by default; the
# numbers it exports are system-level only (never a transcript or caller
# data — see app/core/metrics.py). Set to false to turn the route off.
METRICS_ENABLED=true

# /metrics is never served anonymously: it names the customer API hostnames
# that have tripped a circuit breaker and reports how many calls are live.
# A logged-in user always passes. Set this as well to let a Prometheus
# scraper authenticate with a static bearer token, which is the only thing
# its scrape config can actually send:
#   openssl rand -hex 32
# then in prometheus.yml:
#   authorization: {type: Bearer, credentials: "<the value>"}
METRICS_TOKEN=

# Only read by deploy/docker-compose.monitoring.yml (Prometheus + Grafana,
# brought up separately and never on a public port — see that file). Set it
# before first launch: Grafana's default is literally "admin".
GRAFANA_PASSWORD=
