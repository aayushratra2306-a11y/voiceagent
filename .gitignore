# Environment variables - never commit these
.env
*.env
deploy/.env

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.pytest_cache/

# Task 2.2 — local model weights (faster-whisper's own HF cache, Piper
# .onnx/.onnx.json voices). Large binaries, and every dev re-downloads them
# on first use anyway — nothing here is meant to be shared via git.
backend/local_models/

# Task 4.6 — the circuit breaker store (app/core/breaker.py). Deliberately
# NOT persisted across restarts (a fresh process should start by trusting
# its providers again), and per-machine by design, so there is nothing here
# worth sharing via git.
backend/.state/

# Task 4.9 — the SMTP password Alertmanager sends alert mail with. A live
# credential to a real mailbox, kept in a file rather than in
# deploy/alertmanager.yml (which is committed) or deploy/.env (which would
# force the call-serving backend to recreate every time it changed).
deploy/smtp_password

# Node
node_modules/
dist/
.next/

